{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nullxes.local/schemas/shinra-data-v1-materialization-receipt.json",
  "title": "SHINRA DATA V1 materialization receipt",
  "description": "Runtime scratch fact for one local JSONL slice. Not git governance. No URLs, paths, or credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "slice_id",
    "content_sha256",
    "bytes",
    "records",
    "created_by",
    "upstream",
    "input"
  ],
  "properties": {
    "schema_version": {
      "const": "shinra-data-v1-materialization-receipt"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "slice_id": {
      "type": "string",
      "minLength": 1
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA-256 of the exact final JSONL file bytes on disk."
    },
    "bytes": {
      "type": "integer",
      "minimum": 1
    },
    "records": {
      "type": "integer",
      "minimum": 1
    },
    "created_by": {
      "const": "shinra-data-v1-materializer"
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "subset", "revision"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
        },
        "subset": { "type": ["string", "null"] },
        "revision": { "type": ["string", "null"] }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format"],
      "properties": {
        "format": { "const": "jsonl" }
      }
    }
  }
}
